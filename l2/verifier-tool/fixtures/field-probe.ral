// SPDX-License-Identifier: Apache-2.0
// Development arithmetic fixture only. One immutable modulus, no assets or deployment.
// Each dispatch exercises the inherited production field implementation.

Contract Bn254FieldProbe(fpModulus: U256) extends Bn254Fp2(fpModulus) {
    pub fn probe(op: U256, a0: U256, a1: U256, b0: U256, b1: U256) -> (U256, U256) {
        fpCheckParameters()
        assert!(op < 13, 1099)
        if (op == 0) {
            return fpAdd(a0, b0), 0
        } else if (op == 1) {
            return fpSub(a0, b0), 0
        } else if (op == 2) {
            return fpNeg(a0), 0
        } else if (op == 3) {
            return fpMul(a0, b0), 0
        } else if (op == 4) {
            return fpSquare(a0), 0
        } else if (op == 5) {
            return fpInv(a0), 0
        } else if (op == 6) {
            let result = fp2Add([a0, a1], [b0, b1])
            return result[0], result[1]
        } else if (op == 7) {
            let result = fp2Sub([a0, a1], [b0, b1])
            return result[0], result[1]
        } else if (op == 8) {
            let result = fp2Neg([a0, a1])
            return result[0], result[1]
        } else if (op == 9) {
            let result = fp2Mul([a0, a1], [b0, b1])
            return result[0], result[1]
        } else if (op == 10) {
            let result = fp2Square([a0, a1])
            return result[0], result[1]
        } else if (op == 11) {
            let result = fp2Inv([a0, a1])
            return result[0], result[1]
        } else {
            let result = fp2MulNonResidue([a0, a1])
            return result[0], result[1]
        }
    }
}
