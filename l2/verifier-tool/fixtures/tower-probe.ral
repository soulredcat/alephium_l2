// SPDX-License-Identifier: Apache-2.0
// Development-only arithmetic fixture: one immutable modulus, no asset authority.
// Scalar arguments avoid assuming that the RPC accepts nested array arguments.
// Flat layout: C0.B0(real,imag), B1, B2; then the same six cells for C1.
// Ops 0..5: Fp6 mul/square/inverse/mul-v/mul-Fp2/mul-01 (six zero result pads).
// Op 6: Fp12 add/sub/neg/mul composite; 7..9: square/inverse/conjugate.
// Ops 10..12: Frobenius 1/2/3.
// Op 13: establish the pairing easy part, then square in the cyclotomic group.

Contract Bn254TowerProbe(fpModulus: U256) extends Bn254Frobenius(fpModulus),
    Bn254Fp12Additive(fpModulus), Bn254Cyclotomic(fpModulus) {
    pub fn probe(
        op: U256,
        a0: U256, a1: U256, a2: U256, a3: U256, a4: U256, a5: U256,
        a6: U256, a7: U256, a8: U256, a9: U256, a10: U256, a11: U256,
        b0: U256, b1: U256, b2: U256, b3: U256, b4: U256, b5: U256,
        b6: U256, b7: U256, b8: U256, b9: U256, b10: U256, b11: U256
    ) -> [U256; 12] {
        fpCheckParameters()
        assert!(op < 14, 1099)
        if (op < 6) {
            let result = probeFp6(op, [a0, a1, a2, a3, a4, a5], [b0, b1, b2, b3, b4, b5])
            return [result[0], result[1], result[2], result[3], result[4], result[5], 0, 0, 0, 0, 0, 0]
        } else {
            let a = [a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11]
            let b = [b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11]
            return probeFp12(op, a, b)
        }
    }

    fn probeFp6(op: U256, a: [U256; 6], b: [U256; 6]) -> [U256; 6] {
        if (op == 0) {
            return fp6Mul(a, b)
        } else if (op == 1) {
            return fp6Square(a)
        } else if (op == 2) {
            return fp6Inv(a)
        } else if (op == 3) {
            return fp6MulNonResidue(a)
        } else if (op == 4) {
            return fp6MulByFp2(a, [b[0], b[1]])
        } else {
            return fp6Mul01(a, [b[0], b[1]], [b[2], b[3]])
        }
    }

    fn probeFp12(op: U256, a: [U256; 12], b: [U256; 12]) -> [U256; 12] {
        if (op == 6) {
            // Reach additive helpers through a nontrivial composite value;
            // independent Arkworks expects (a-b)*(-(a+b)).
            let difference = fp12Sub(a, b)
            let negativeSum = fp12Neg(fp12Add(a, b))
            return fp12Mul(difference, negativeSum)
        } else if (op == 7) {
            return fp12Square(a)
        } else if (op == 8) {
            return fp12Inv(a)
        } else if (op == 9) {
            return fp12Conjugate(a)
        } else if (op == 10) {
            return fp12Frobenius(a, 1)
        } else if (op == 11) {
            return fp12Frobenius(a, 2)
        } else if (op == 12) {
            return fp12Frobenius(a, 3)
        } else {
            // a^(p^6-1) is unitary; exponent p^2+1 puts it in the cyclotomic
            // subgroup. Never call cyclotomic square directly on arbitrary a.
            let unitary = fp12Mul(fp12Conjugate(a), fp12Inv(a))
            let cyclotomic = fp12Mul(fp12Frobenius(unitary, 2), unitary)
            return fp12CyclotomicSquare(cyclotomic)
        }
    }
}
