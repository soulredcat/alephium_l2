// Fp12 algebra translated from Gnark Crypto revision
// 703a260c2f991d01e245adf53d20f76af4210c5f, ecc/bn254/internal/fptower/e12.go:
// Mul, Square, Inverse and Conjugate.
// https://github.com/Consensys/gnark-crypto/blob/703a260c2f991d01e245adf53d20f76af4210c5f/ecc/bn254/internal/fptower/e12.go
// Flat canonical layout is [C0.B0.A0, C0.B0.A1, C0.B1.A0, C0.B1.A1,
// C0.B2.A0, C0.B2.A1, C1.B0.A0, C1.B0.A1, C1.B1.A0, C1.B1.A1,
// C1.B2.A0, C1.B2.A1]. It represents C0 + C1*w, where w^2 = v.
// Value arguments and fresh temporaries preserve upstream alias-safe formulas.
// These internal methods share the checked immutable modulus; no external field authority.

Abstract Contract Bn254Fp12(fpModulus: U256) extends Bn254Fp6(fpModulus) {
    const FP12_ZERO_INVERSE = 1031

    fn fp12Validate(a: [U256; 12]) -> () {
        for (let mut i = 0; i < 12; i = i + 1) {
            fpValidate(a[i])
        }
    }

    // Karatsuba: (a0*b0 + v*a1*b1, (a0+a1)*(b0+b1)-a0*b0-a1*b1).
    fn fp12Mul(a: [U256; 12], b: [U256; 12]) -> [U256; 12] {
        fp12Validate(a)
        fp12Validate(b)
        let a0 = [a[0], a[1], a[2], a[3], a[4], a[5]]
        let a1 = [a[6], a[7], a[8], a[9], a[10], a[11]]
        let b0 = [b[0], b[1], b[2], b[3], b[4], b[5]]
        let b1 = [b[6], b[7], b[8], b[9], b[10], b[11]]
        let sumProduct = fp6Mul(fp6Add(a0, a1), fp6Add(b0, b1))
        let product0 = fp6Mul(a0, b0)
        let product1 = fp6Mul(a1, b1)
        let c1 = fp6Sub(fp6Sub(sumProduct, product0), product1)
        let c0 = fp6Add(fp6MulNonResidue(product1), product0)
        return [c0[0], c0[1], c0[2], c0[3], c0[4], c0[5],
            c1[0], c1[1], c1[2], c1[3], c1[4], c1[5]]
    }

    // General square, upstream Algorithm 22: (a0^2 + v*a1^2, 2*a0*a1).
    // The optimized C0 expression is (a0-a1)*(a0-v*a1) + (1+v)*a0*a1.
    fn fp12Square(a: [U256; 12]) -> [U256; 12] {
        fp12Validate(a)
        let a0 = [a[0], a[1], a[2], a[3], a[4], a[5]]
        let a1 = [a[6], a[7], a[8], a[9], a[10], a[11]]
        // Complete entry validation precedes native operations. Native results
        // are canonical; p-x is safe, including x=0 where addModN reduces p.
        let difference = [
            addModN!(a[0], fpModulus - a[6], fpModulus),
            addModN!(a[1], fpModulus - a[7], fpModulus),
            addModN!(a[2], fpModulus - a[8], fpModulus),
            addModN!(a[3], fpModulus - a[9], fpModulus),
            addModN!(a[4], fpModulus - a[10], fpModulus),
            addModN!(a[5], fpModulus - a[11], fpModulus)
        ]
        // v*a1 = ((9+u)*a1.B2, a1.B0, a1.B1).
        let otherDifference = [
            addModN!(a[0], fpModulus - addModN!(mulModN!(a[10], 9, fpModulus),
                fpModulus - a[11], fpModulus), fpModulus),
            addModN!(a[1], fpModulus - addModN!(a[10],
                mulModN!(a[11], 9, fpModulus), fpModulus), fpModulus),
            addModN!(a[2], fpModulus - a[6], fpModulus),
            addModN!(a[3], fpModulus - a[7], fpModulus),
            addModN!(a[4], fpModulus - a[8], fpModulus),
            addModN!(a[5], fpModulus - a[9], fpModulus)
        ]
        let product = fp6Mul(a0, a1)
        let partial = fp6Mul(difference, otherDifference)
        // Both checked products are canonical. Return C0=partial+product+v*product
        // and C1=2*product directly; no subgroup assumption or intermediate guard.
        return [
            addModN!(addModN!(partial[0], product[0], fpModulus), addModN!(
                mulModN!(product[4], 9, fpModulus), fpModulus - product[5], fpModulus), fpModulus),
            addModN!(addModN!(partial[1], product[1], fpModulus), addModN!(
                product[4], mulModN!(product[5], 9, fpModulus), fpModulus), fpModulus),
            addModN!(addModN!(partial[2], product[2], fpModulus), product[0], fpModulus),
            addModN!(addModN!(partial[3], product[3], fpModulus), product[1], fpModulus),
            addModN!(addModN!(partial[4], product[4], fpModulus), product[2], fpModulus),
            addModN!(addModN!(partial[5], product[5], fpModulus), product[3], fpModulus),
            addModN!(product[0], product[0], fpModulus), addModN!(product[1], product[1], fpModulus),
            addModN!(product[2], product[2], fpModulus), addModN!(product[3], product[3], fpModulus),
            addModN!(product[4], product[4], fpModulus), addModN!(product[5], product[5], fpModulus)
        ]
    }

    // Upstream Algorithm 23: inverse = (a0, -a1)/(a0^2-v*a1^2).
    // Unlike upstream's zero-return behavior, zero is rejected before inversion.
    fn fp12Inv(a: [U256; 12]) -> [U256; 12] {
        fp12Validate(a)
        let mut nonzero = false
        for (let mut i = 0; i < 12; i = i + 1) {
            nonzero = nonzero || a[i] != 0
        }
        assert!(nonzero, FP12_ZERO_INVERSE)
        let a0 = [a[0], a[1], a[2], a[3], a[4], a[5]]
        let a1 = [a[6], a[7], a[8], a[9], a[10], a[11]]
        let square0 = fp6Square(a0)
        let square1 = fp6Square(a1)
        let norm = fp6Sub(square0, fp6MulNonResidue(square1))
        let inverseNorm = fp6Inv(norm)
        let c0 = fp6Mul(a0, inverseNorm)
        let c1 = fp6Neg(fp6Mul(a1, inverseNorm))
        return [c0[0], c0[1], c0[2], c0[3], c0[4], c0[5],
            c1[0], c1[1], c1[2], c1[3], c1[4], c1[5]]
    }

    // Conjugation negates C1; it equals inverse only for unitary elements.
    fn fp12Conjugate(a: [U256; 12]) -> [U256; 12] {
        fp12Validate(a)
        let c1 = fp6Neg([a[6], a[7], a[8], a[9], a[10], a[11]])
        return [a[0], a[1], a[2], a[3], a[4], a[5],
            c1[0], c1[1], c1[2], c1[3], c1[4], c1[5]]
    }

}
