// Canonical RISC Zero Ethereum revision 365e7b2db4f620fa256580c27558d2623362b9ae:
// contracts/src/groth16/RiscZeroGroth16Verifier.sol (GPL-3.0 wrapper),
// contracts/src/IRiscZeroVerifier.sol, Util.sol and groth16/ControlID.sol
// (Apache-2.0 success claim, endian mapping and circuit constants).
// This target admits only an unconditional Halted(0) claim with zero input.
// Proof transport is strictly selector4 || eight original BE U256 words.

Contract Risc0ReceiptVerifier(fpModulus: U256) extends Risc0ReceiptClaims(fpModulus),
    Bn254MillerEngine(fpModulus), Bn254Exponent(fpModulus) {
    const RECEIPT_PAIRING_FAILED = 1404
    pub fn verify(seal: ByteVec, imageId: ByteVec, journalDigest: ByteVec) -> [U256; 12] {
        fpCheckParameters()
        let pairs = receiptPairs(seal, imageId, journalDigest)
        let result = fp12FinalExponentiation(millerLoopAdmitted4(pairs))
        let mut isOne = result[0] == 1
        for (let mut i = 1; i < 12; i = i + 1) {
            isOne = isOne && result[i] == 0
        }
        assert!(isOne, RECEIPT_PAIRING_FAILED)
        return result
    }
}
